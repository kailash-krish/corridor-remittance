BACKEND_URL=http://127.0.0.1:4100
APP_ORIGIN=http://127.0.0.1:3100
DEMO_MODE=true
# Match the backend SUPABASE_JWT_SECRET. npm run setup creates a random local value.
DEMO_JWT_SECRET=replace-with-the-same-random-backend-secret

# Local canonical URL. Vercel auto-detects its production domain when this is unset.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# Optional GA4 ID, e.g. G-ABC123DEF4. Empty means no analytics requests.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Hosted mode only: configure in Vercel, not in the local demo.
# CORRIDOR_HOSTED=true
# BLOB_READ_WRITE_TOKEN=<supplied by the connected private Blob store>
# DEMO_JWT_SECRET=<new random hosted secret>
# Leave APP_ORIGIN and BACKEND_URL unset on Vercel.
